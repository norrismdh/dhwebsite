{
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/Home", "destination": "/", "permanent": true },
    { "source": "/Home.html", "destination": "/", "permanent": true },
    { "source": "/solutions", "destination": "/Product", "permanent": true },
    { "source": "/solutions/:path*", "destination": "/Product", "permanent": true },
    { "source": "/data-literacy", "destination": "/Resources", "permanent": true },
    { "source": "/data-literacy/:path*", "destination": "/Resources", "permanent": true },

    { "source": "/about", "destination": "/About", "permanent": true },
    { "source": "/architecture", "destination": "/Architecture", "permanent": true },
    { "source": "/blog", "destination": "/Blog", "permanent": true },
    { "source": "/clarity", "destination": "/Clarity", "permanent": true },
    { "source": "/connectors", "destination": "/Connectors", "permanent": true },
    { "source": "/contact", "destination": "/Contact", "permanent": true },
    { "source": "/customers", "destination": "/Customers", "permanent": true },
    { "source": "/demo", "destination": "/Demo", "permanent": true },
    { "source": "/denver", "destination": "/Denver", "permanent": true },
    { "source": "/faq", "destination": "/FAQ", "permanent": true },
    { "source": "/partners", "destination": "/Partners", "permanent": true },
    { "source": "/pattison", "destination": "/Pattison", "permanent": true },
    { "source": "/pricing", "destination": "/Pricing", "permanent": true },
    { "source": "/privacy", "destination": "/Privacy", "permanent": true },
    { "source": "/product", "destination": "/Product", "permanent": true },
    { "source": "/resources", "destination": "/Resources", "permanent": true },
    { "source": "/security", "destination": "/Security", "permanent": true },
    { "source": "/terms", "destination": "/Terms", "permanent": true },
    { "source": "/usecases", "destination": "/UseCases", "permanent": true },
    { "source": "/use-cases", "destination": "/UseCases", "permanent": true }
  ],
  "rewrites": [
    { "source": "/downloads/:fileId", "destination": "/api/download/:fileId" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",        "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-XSS-Protection",          "value": "1; mode=block" },
        { "key": "Access-Control-Allow-Origin", "value": "https://www.digitalhive.com" }
      ]
    },
    {
      "source": "/styles/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/styles/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/scripts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=604800" }
      ]
    }
  ]
}
